# Gemini secret: configure only in your backend provider's environment variables.
GEMINI_API_KEY=
# Current stable model may change; see Google AI for Developers model documentation.
GEMINI_MODEL=gemini-3.8-flash
PORT=3000
# Cross-origin frontend origins, comma-separated. Required only when frontend/backend differ.
FRONTEND_ORIGINS=https://shubh07272.github.io,http://localhost:3000
# Set true only if this service is behind exactly one trusted reverse proxy.
TRUST_PROXY=false
